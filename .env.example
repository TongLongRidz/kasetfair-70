# ==============================================================================
# Global / Environment Configuration for Kaset Fair
# ==============================================================================

# Backend Service Configuration
BACKEND_PORT=8585
APP_ENV=development

# Security & Authentication Configuration
# Generated with: openssl rand -base64 33
AUTH_SECRET=
JWT_SECRET=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5488
DB_USER=kaset_user
DB_PASSWORD=kaset_secret_pass
DB_NAME=kaset_db
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_PASSWORD=

# QR Verification Service Configuration (Python Microservice)
QR_VERIFY_PORT=8586

# Frontend Service Configuration (Next.js)
FRONTEND_PORT=3050
NEXT_PUBLIC_API_URL=http://localhost:8585
NEXT_PUBLIC_QR_VERIFY_URL=http://localhost:8586
NEXT_PUBLIC_LANG_STORAGE_KEY=kaset_app_lang